# LLM Provider: 'groq' or 'gemini' (Groq recommended for high rate limits)
LLM_PROVIDER=groq

# Groq Cloud API Key (Get free key at: https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini API Key (Get at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# GitHub Token (optional, for code repo integration)
GITHUB_TOKEN=your_github_token_here

# GitLab Token (optional)
GITLAB_TOKEN=your_gitlab_token_here
GITLAB_URL=https://gitlab.com
